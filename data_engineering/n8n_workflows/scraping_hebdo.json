      "id": "dd323731-bc17-40d5-8f5d-23a07657c36f",
      "name": "Boucle un film a la fois",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1792,
        608
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Voici le synopsis d'un film :\n\n{{ $json.synopsis }}\n\nReponds uniquement avec exactement 3 mots-cles qui resument ce film, en francais, separes par des virgules. Pas de phrase, pas d'introduction, juste les 3 mots-cles. juste un mot de 50 caractère maximum"
      },
      "id": "cd8fc1a4-df28-4964-93c8-afbe0002a0ca",
      "name": "Extraire mots-cles",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2288,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "const motsCles = $input.item.json.text.split(',').map(m => m.trim()).slice(0, 3);\nreturn {\n  id_oeuvre: $('Recuperer synopsis').item.json.id_oeuvre,\n  mot_cle_1: motsCles[0] || null,\n  mot_cle_2: motsCles[1] || null,\n  mot_cle_3: motsCles[2] || null,\n};"
      },
      "id": "f37d6993-fd9a-4d6a-a3da-2985b88da0e1",
      "name": "Decouper la reponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2544,
        720
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE oeuvre SET mot_cle_1 = $1, mot_cle_2 = $2, mot_cle_3 = $3 WHERE id_oeuvre = $4;",
        "options": {
          "queryReplacement": "={{ $json.mot_cle_1 }},{{ $json.mot_cle_2 }},{{ $json.mot_cle_3 }},{{ $json.id_oeuvre }}"
        }
      },
      "id": "99ba3f4c-9409-4060-817c-ce4913ffd334",

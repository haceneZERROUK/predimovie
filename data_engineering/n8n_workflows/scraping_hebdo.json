    {
      "parameters": {
        "jsCode": "// jpbox numerote les semaines depuis janvier 1970, ca avance de 1 par semaine\n// on veut la semaine QUI VIENT DE SE TERMINER (ses entrees sont publiees), pas\n// la semaine a venir (+1.714 donne cette semaine-la, JPBOX renvoie 'missing' dessus\n// tant qu'elle n'est pas terminee) - verifie en conditions reelles le 25/08/2026\nconst epoque = new Date('1970-01-05T00:00:00Z');\nconst maintenant = new Date();\nconst nbSemaines = (maintenant - epoque) / (1000 * 60 * 60 * 24 * 7);\nconst idsem = Math.round(nbSemaines + 1.714) - 1;\nreturn { idsem };"
      },
      "id": "code-idsem",
      "name": "Calculer la semaine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        208
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://scraper:8001/scrape/entrees?idsem={{ $json.idsem }}&vue=2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "http-entrees",
      "name": "Scraper entrees semaine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,

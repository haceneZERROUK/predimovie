          "id": "uuh2lnKtVyyYS44T",
          "name": "Predimovie Scraper API"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id_oeuvre, synopsis FROM oeuvre WHERE synopsis IS NOT NULL AND length(synopsis) > 50 AND mot_cle_1 IS NULL;",
        "options": {}
      },
      "id": "380b2bc2-5648-406e-90df-9b98033ded7a",
